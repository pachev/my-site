---
const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/posts', label: 'POSTS' },
  { href: '/tils', label: 'TIL' },
  { href: '/lab', label: 'LAB' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header>
  <div class="header-container">
    <a href="/" class="logotype">PJ<span class="underscore">_</span></a>
    <nav>
      <ul class="nav-links">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="https://github.com/pachev" target="_blank" rel="noopener noreferrer" class="nav-link projects-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
            <span>PROJECTS</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 24px 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logotype {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .logotype:hover {
    color: var(--color-text);
  }

  .logotype .underscore {
    color: var(--color-sage);
  }

  .nav-links {
    display: flex;
    list-style: none;
    align-items: center;
    gap: 36px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    padding-left: 0;
    margin-bottom: 0;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    color: var(--color-muted);
    padding-bottom: 3px;
    transition: color 0.15s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-sage);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link:active {
    color: var(--color-accent-hover);
  }

  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active::after {
    background: var(--color-sage);
    transform: scaleX(1);
    transition: none;
  }

  .projects-link {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .header-container {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .nav-links {
      flex-wrap: wrap;
      gap: 18px;
    }
  }
</style>
