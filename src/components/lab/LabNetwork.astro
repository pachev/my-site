---
// Workspace 1: network topology with phase 2 node inspector launchers.
import { NODE_DATA, SNAPSHOT_LABEL } from '../../data/labSnapshot';
const nodes = ['security-pve', 'ser5-proxmox', 'pve-ser-24gb', 's13-proxmox', 'joseph-nas'].map((id) => ({
  id, name: `[ ${id} ]`, meta: ({ 'security-pve': 'N150 · CORAL TPU', 'ser5-proxmox': '5850U · 8C / 16T', 'pve-ser-24gb': '6800U · 8C / 16T', 's13-proxmox': 'N150 · INTEL GPU', 'joseph-nas': 'ZFS · 2×4 TB MIRROR' } as Record<string, string>)[id], svc: NODE_DATA[id].summary,
  status: id === 'joseph-nas' ? 'ZFS · 61% ALLOCATED' : 'ONLINE · OCT 01', idle: false,
}));
const initialNode = NODE_DATA['security-pve'];
---

<section class="lab-scene lab-network active" data-scene="1" role="tabpanel" aria-label="Network topology">
  <div class="lab-net-topo">
    <div class="lab-tbox lab-tbox-wan">
      <span class="lab-tlabel">WAN</span>
      <span class="lab-tname">/// ATT FIBER ///</span>
    </div>
    <div class="lab-vline lab-vline-1"></div>

    <div class="lab-tbox lab-tbox-gw">
      <span class="lab-tlabel">GATEWAY</span>
      <span class="lab-tname">UCG FIBER</span>
      <span class="lab-tstat"><span class="lab-dot"></span> PORT 5 LINK · 10 Gbps</span>
    </div>
    <div class="lab-vline lab-vline-2"></div>

    <div class="lab-tbox lab-tbox-sw">
      <span class="lab-tlabel" title="Snapshot: Network app 10.6.106; gateway firmware 5.1.33; eight enabled networks/VLANs">UNIFI SITE · 6 DEVICES / 8 NETWORKS</span>
      <span class="lab-tname">2 SWITCHES · 3 APs</span>
      <span class="lab-tstat"><span class="lab-dot"></span> 49 CLIENTS · 31 WIRED / 18 WIFI</span>
    </div>

    <div class="lab-hline lab-hline-dashed"></div>
    <div class="lab-tbox lab-tbox-tunnel">
      <span class="lab-tlabel">INGRESS</span>
      <span class="lab-tname">CLOUDFLARE TUNNEL</span>
      <span class="lab-tstat" title="Atuin · Coolify · Katzenbase · PocketID, October 1 snapshot">4 TUNNELS · SNAPSHOT</span>
    </div>

    <div class="lab-vline lab-vline-rail"></div>

    <div class="lab-node-rail">
      {nodes.map((node) => (
        <button
          type="button"
          class:list={['lab-node', { 'lab-node-idle': node.idle, 'lab-node-selected': node.id === 'security-pve' }]}
          data-open-node={node.id}
          aria-label={`Open ${node.id} inspector`}
          aria-pressed={node.id === 'security-pve' ? 'true' : 'false'}
        >
          <span class="lab-nname">{node.name}</span>
          <span class="lab-nmeta">{node.meta}</span>
          <span class="lab-nsvc">
            {node.svc}
            {node.idle && <span class="lab-caret">▮</span>}
          </span>
          <span class="lab-tstat"><span class="lab-dot"></span> {node.status}</span>
        </button>
      ))}
    </div>

    <div class="lab-window-layer lab-network-windows" data-window-layer>
      <div
        class="lab-window lab-inspector lab-window-focused"
        data-managed-window
        data-window-id="network-security-pve"
        data-window-mode="floating"
        data-node="security-pve"
      >
        <div class="lab-titlebar">
          <span class="lab-tb-title" data-window-title>security-pve — node inspector</span>
          <button type="button" class="lab-tb-x" data-window-close aria-label="Close security-pve inspector">✕</button>
        </div>
        <div class="lab-win-body">
          <div class="lab-kv"><span class="lab-k">HARDWARE</span><span class="lab-v" data-inspector-hw>{initialNode.hw}</span></div>
          <div class="lab-kv"><span class="lab-k">PLATFORM</span><span class="lab-v" data-inspector-platform>{initialNode.platform}</span></div>
          <div class="lab-gauge-row"><span class="lab-k">CPU</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="cpu" style={`width:${initialNode.cpu}%`}></div></div><span class="lab-gval" data-gauge-value="cpu">{initialNode.cpu}%</span></div>
          <div class="lab-gauge-row"><span class="lab-k">RAM</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="ram" style={`width:${initialNode.ram}%`}></div></div><span class="lab-gval" data-gauge-value="ram">{initialNode.ram}%</span></div>
          <div class="lab-svc-head">SERVICES</div>
          <div class="lab-snapshot-label">{SNAPSHOT_LABEL}</div>
          <div data-inspector-services>
            {initialNode.svcs.map(([name, note]) => <div class="lab-svc"><span class="lab-dot"></span> {name} <span class="lab-svc-note">{note}</span></div>)}
          </div>
          <div class="lab-win-foot" data-inspector-foot>{initialNode.foot}<span class="lab-caret">▮</span></div>
        </div>
      </div>
    </div>
  </div>

  <template id="lab-node-inspector-template">
    <div class="lab-window lab-inspector" data-managed-window data-window-mode="tiled" hidden>
      <div class="lab-titlebar">
        <span class="lab-tb-title" data-window-title>node inspector</span>
        <button type="button" class="lab-tb-x" data-window-close aria-label="Close node inspector">✕</button>
      </div>
      <div class="lab-win-body">
        <div class="lab-kv"><span class="lab-k">HARDWARE</span><span class="lab-v" data-inspector-hw></span></div>
        <div class="lab-kv"><span class="lab-k">PLATFORM</span><span class="lab-v" data-inspector-platform></span></div>
        <div class="lab-gauge-row"><span class="lab-k">CPU</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="cpu"></div></div><span class="lab-gval" data-gauge-value="cpu"></span></div>
        <div class="lab-gauge-row"><span class="lab-k">RAM</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="ram"></div></div><span class="lab-gval" data-gauge-value="ram"></span></div>
        <div class="lab-svc-head">SERVICES</div>
        <div class="lab-snapshot-label">{SNAPSHOT_LABEL}</div>
        <div data-inspector-services></div>
        <div class="lab-win-foot" data-inspector-foot></div>
      </div>
    </div>
  </template>

  <div class="lab-hintbar">SNAPSHOT OCT 01 · ISP SPEED NOT MEASURED&nbsp;&nbsp;&middot;&nbsp;&nbsp;DRAG TITLEBAR TO FLOAT&nbsp;&nbsp;&middot;&nbsp;&nbsp;DOUBLE-CLICK TO TILE · <button type="button" class="lab-shell-launcher" data-trace-open aria-controls="lab-trace" aria-haspopup="dialog">Trace this page →</button></div>
</section>

<style>
  .lab-net-topo {
    position: relative;
    /* The rail stays in flow, reserving space for every node above the hintbar. */
    min-height: max(760px, calc(100% - 40px));
    padding: 0 0 56px;
  }

  .lab-tbox {
    position: absolute;
    left: 200px;
    width: 280px;
    border: 1px solid var(--lab-border);
    background: var(--lab-surface);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lab-tbox-wan {
    top: 24px;
    background: transparent;
    border-style: dashed;
  }

  .lab-tbox-gw {
    top: 102px;
  }

  .lab-tbox-sw {
    top: 208px;
  }

  .lab-tbox-tunnel {
    top: 110px;
    left: 570px;
    width: 230px;
    border-color: var(--lab-border-bright);
  }

  .lab-tlabel {
    font-size: 9px;
    letter-spacing: 0.22em;
    color: var(--lab-muted);
  }

  .lab-tname {
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--lab-bright);
  }

  .lab-tstat {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--lab-sage);
  }

  .lab-vline {
    position: absolute;
    left: 339px;
    width: 2px;
    background: var(--lab-border);
  }

  .lab-vline-1 {
    top: 78px;
    height: 24px;
  }

  .lab-vline-2 {
    top: 174px;
    height: 34px;
  }

  .lab-vline-rail {
    left: 240px;
    top: 280px;
    height: 452px;
  }

  .lab-hline {
    position: absolute;
    height: 2px;
    background: var(--lab-border);
    left: 480px;
    top: 138px;
    width: 90px;
  }

  .lab-hline-dashed {
    background: repeating-linear-gradient(90deg, var(--lab-border) 0 6px, transparent 6px 11px);
  }

  .lab-node-rail {
    position: relative;
    margin-left: 280px;
    padding-top: 300px;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lab-node {
    position: relative;
    border: 1px solid var(--lab-border);
    background: var(--lab-surface);
    padding: 10px 14px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    cursor: pointer;
    width: 100%;
    color: inherit;
    font: inherit;
    text-align: left;
  }

  .lab-node::before {
    content: '';
    position: absolute;
    left: -40px;
    top: 50%;
    width: 40px;
    height: 2px;
    background: var(--lab-border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lab-node {
      transition: border-color 0.12s ease, transform 0.08s ease;
    }

    .lab-node:active {
      transform: translate(1px, 1px);
    }
  }

  .lab-node:hover {
    border-color: var(--lab-sage);
  }

  .lab-node-selected {
    border-color: var(--lab-sage);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.45);
  }

  .lab-nname {
    font-size: 13px;
    color: var(--lab-bright);
    letter-spacing: 0.06em;
  }

  .lab-nmeta {
    font-size: 10px;
    color: var(--lab-muted);
    letter-spacing: 0.1em;
    text-align: right;
  }

  .lab-nsvc {
    font-size: 10px;
    color: var(--lab-accent);
    letter-spacing: 0.12em;
  }

  .lab-node .lab-tstat {
    text-align: right;
  }

  .lab-node-idle .lab-nsvc {
    color: var(--lab-muted);
  }

  .lab-network-windows {
    position: absolute;
    left: 640px;
    right: 32px;
    top: 82px;
    bottom: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 14px;
    align-content: start;
    pointer-events: none;
  }

  .lab-network-windows .lab-window {
    pointer-events: auto;
    min-width: 0;
  }

  .lab-network-windows [data-window-mode='floating'] {
    top: 28px;
    right: 0;
    width: min(520px, 100%);
  }

  @media (max-width: 900px) {
    .lab-net-topo {
      min-height: 0;
      padding: 20px 16px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .lab-tbox,
    .lab-node-rail,
    .lab-network-windows {
      position: static;
      width: 100%;
      max-width: 100%;
      display: grid;
      grid-template-columns: 1fr;
    }

    .lab-tbox-tunnel {
      border-style: dashed;
    }

    .lab-vline,
    .lab-hline {
      display: none;
    }

    .lab-node-rail {
      margin-left: 0;
      padding-top: 0;
      gap: 12px;
    }

    .lab-node::before {
      display: none;
    }
  }
</style>
