---
// Workspace 1: network topology with phase 2 node inspector launchers.
const nodes = [
  { id: 'security-pve', name: '[ security-pve ]', meta: 'N150 · CORAL TPU', svc: 'FRIGATE', status: 'ONLINE', idle: false },
  { id: 'ser5-proxmox', name: '[ ser5-proxmox ]', meta: 'RYZEN 7 5850U · 27G', svc: 'COOLIFY · HOME ASSISTANT', status: 'ONLINE', idle: false },
  { id: 'pve-ser-24gb', name: '[ pve-ser-24gb ]', meta: 'RYZEN 7 6800U · 19G', svc: 'KATZENBASE · IMMICH · CI', status: 'ONLINE', idle: false },
  { id: 's13-proxmox', name: '[ s13-proxmox ]', meta: 'N150 · SPARE', svc: 'IDLE // AWAITING PURPOSE', status: 'ONLINE', idle: true },
  { id: 'joseph-nas', name: '[ joseph-nas ]', meta: 'NODE 304 · ZFS 4×HDD', svc: 'NFS EXPORTS ×4', status: 'ONLINE · 58% USED', idle: false },
];
---

<section class="lab-scene lab-network active" data-scene="1" role="tabpanel" aria-label="Network topology">
  <div class="lab-net-topo">
    <div class="lab-tbox lab-tbox-wan">
      <span class="lab-tlabel">WAN</span>
      <span class="lab-tname">/// ATT FIBER ///</span>
    </div>
    <div class="lab-vline lab-vline-1"></div>

    <div class="lab-tbox lab-tbox-gw">
      <span class="lab-tlabel">GATEWAY</span>
      <span class="lab-tname">UCG FIBER</span>
      <span class="lab-tstat"><span class="lab-dot"></span> ONLINE · 10G WAN</span>
    </div>
    <div class="lab-vline lab-vline-2"></div>

    <div class="lab-tbox lab-tbox-sw">
      <span class="lab-tlabel">SWITCH</span>
      <span class="lab-tname">USW-LITE-16-POE</span>
      <span class="lab-tstat"><span class="lab-dot"></span> ONLINE · 48 CLIENTS</span>
    </div>

    <div class="lab-hline lab-hline-dashed"></div>
    <div class="lab-tbox lab-tbox-tunnel">
      <span class="lab-tlabel">INGRESS</span>
      <span class="lab-tname">CLOUDFLARE TUNNEL</span>
      <span class="lab-tstat">ONLY WAY IN ⇄</span>
    </div>

    <div class="lab-vline lab-vline-rail"></div>

    <div class="lab-node-rail">
      {nodes.map((node) => (
        <button
          type="button"
          class:list={['lab-node', { 'lab-node-idle': node.idle, 'lab-node-selected': node.id === 'security-pve' }]}
          data-open-node={node.id}
          aria-label={`Open ${node.id} inspector`}
          aria-pressed={node.id === 'security-pve' ? 'true' : 'false'}
        >
          <span class="lab-nname">{node.name}</span>
          <span class="lab-nmeta">{node.meta}</span>
          <span class="lab-nsvc">
            {node.svc}
            {node.idle && <span class="lab-caret">▮</span>}
          </span>
          <span class="lab-tstat"><span class="lab-dot"></span> {node.status}</span>
        </button>
      ))}
    </div>

    <div class="lab-window-layer lab-network-windows" data-window-layer>
      <div
        class="lab-window lab-inspector lab-window-focused"
        data-managed-window
        data-window-id="network-security-pve"
        data-window-mode="floating"
        data-node="security-pve"
      >
        <div class="lab-titlebar">
          <span class="lab-tb-title" data-window-title>security-pve — node inspector</span>
          <button type="button" class="lab-tb-x" data-window-close aria-label="Close security-pve inspector">✕</button>
        </div>
        <div class="lab-win-body">
          <div class="lab-kv"><span class="lab-k">HARDWARE</span><span class="lab-v" data-inspector-hw>INTEL N150 · 4C · 15G · CORAL TPU (USB)</span></div>
          <div class="lab-kv"><span class="lab-k">PLATFORM</span><span class="lab-v" data-inspector-platform>PROXMOX VE 8.4 · KERNEL 6.14</span></div>
          <div class="lab-gauge-row"><span class="lab-k">CPU</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="cpu" style="width:34%"></div></div><span class="lab-gval" data-gauge-value="cpu">34%</span></div>
          <div class="lab-gauge-row"><span class="lab-k">RAM</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="ram" style="width:31%"></div></div><span class="lab-gval" data-gauge-value="ram">31%</span></div>
          <div class="lab-svc-head">SERVICES</div>
          <div data-inspector-services>
            <div class="lab-svc"><span class="lab-dot"></span> frigate <span class="lab-svc-note">nixos ct 205 · 6 cameras</span></div>
            <div class="lab-svc"><span class="lab-dot"></span> coral-tpu <span class="lab-svc-note">inference 8.1ms</span></div>
          </div>
          <div class="lab-win-foot" data-inspector-foot>$ uptime → 13 days. do not jinx it.<span class="lab-caret">▮</span></div>
        </div>
      </div>
    </div>
  </div>

  <template id="lab-node-inspector-template">
    <div class="lab-window lab-inspector" data-managed-window data-window-mode="tiled" hidden>
      <div class="lab-titlebar">
        <span class="lab-tb-title" data-window-title>node inspector</span>
        <button type="button" class="lab-tb-x" data-window-close aria-label="Close node inspector">✕</button>
      </div>
      <div class="lab-win-body">
        <div class="lab-kv"><span class="lab-k">HARDWARE</span><span class="lab-v" data-inspector-hw></span></div>
        <div class="lab-kv"><span class="lab-k">PLATFORM</span><span class="lab-v" data-inspector-platform></span></div>
        <div class="lab-gauge-row"><span class="lab-k">CPU</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="cpu"></div></div><span class="lab-gval" data-gauge-value="cpu"></span></div>
        <div class="lab-gauge-row"><span class="lab-k">RAM</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill="ram"></div></div><span class="lab-gval" data-gauge-value="ram"></span></div>
        <div class="lab-svc-head">SERVICES</div>
        <div data-inspector-services></div>
        <div class="lab-win-foot" data-inspector-foot></div>
      </div>
    </div>
  </template>

  <div class="lab-hintbar">CLICK A NODE TO OPEN&nbsp;&nbsp;&middot;&nbsp;&nbsp;DRAG TITLEBAR TO FLOAT&nbsp;&nbsp;&middot;&nbsp;&nbsp;DOUBLE-CLICK TO TILE</div>
</section>

<style>
  .lab-net-topo {
    position: relative;
    /* 760px fits the absolute topology; the max() keeps this scene as tall
       as the others so the hintbar never jumps between workspaces. */
    min-height: max(760px, calc(100% - 40px));
    padding: 0 0 56px;
  }

  .lab-tbox {
    position: absolute;
    left: 200px;
    width: 280px;
    border: 1px solid var(--lab-border);
    background: var(--lab-surface);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lab-tbox-wan {
    top: 24px;
    background: transparent;
    border-style: dashed;
  }

  .lab-tbox-gw {
    top: 102px;
  }

  .lab-tbox-sw {
    top: 208px;
  }

  .lab-tbox-tunnel {
    top: 110px;
    left: 570px;
    width: 230px;
    border-color: var(--lab-border-bright);
  }

  .lab-tlabel {
    font-size: 9px;
    letter-spacing: 0.22em;
    color: var(--lab-muted);
  }

  .lab-tname {
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--lab-bright);
  }

  .lab-tstat {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--lab-sage);
  }

  .lab-vline {
    position: absolute;
    left: 339px;
    width: 2px;
    background: var(--lab-border);
  }

  .lab-vline-1 {
    top: 78px;
    height: 24px;
  }

  .lab-vline-2 {
    top: 174px;
    height: 34px;
  }

  .lab-vline-rail {
    left: 240px;
    top: 280px;
    height: 452px;
  }

  .lab-hline {
    position: absolute;
    height: 2px;
    background: var(--lab-border);
    left: 480px;
    top: 138px;
    width: 90px;
  }

  .lab-hline-dashed {
    background: repeating-linear-gradient(90deg, var(--lab-border) 0 6px, transparent 6px 11px);
  }

  .lab-node-rail {
    position: absolute;
    left: 280px;
    top: 300px;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lab-node {
    position: relative;
    border: 1px solid var(--lab-border);
    background: var(--lab-surface);
    padding: 10px 14px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    cursor: pointer;
    width: 100%;
    color: inherit;
    font: inherit;
    text-align: left;
  }

  .lab-node::before {
    content: '';
    position: absolute;
    left: -40px;
    top: 50%;
    width: 40px;
    height: 2px;
    background: var(--lab-border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lab-node {
      transition: border-color 0.12s ease, transform 0.08s ease;
    }

    .lab-node:active {
      transform: translate(1px, 1px);
    }
  }

  .lab-node:hover {
    border-color: var(--lab-sage);
  }

  .lab-node-selected {
    border-color: var(--lab-sage);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.45);
  }

  .lab-nname {
    font-size: 13px;
    color: var(--lab-bright);
    letter-spacing: 0.06em;
  }

  .lab-nmeta {
    font-size: 10px;
    color: var(--lab-muted);
    letter-spacing: 0.1em;
    text-align: right;
  }

  .lab-nsvc {
    font-size: 10px;
    color: var(--lab-accent);
    letter-spacing: 0.12em;
  }

  .lab-node .lab-tstat {
    text-align: right;
  }

  .lab-node-idle .lab-nsvc {
    color: var(--lab-muted);
  }

  .lab-network-windows {
    position: absolute;
    left: 640px;
    right: 32px;
    top: 82px;
    bottom: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 14px;
    align-content: start;
    pointer-events: none;
  }

  .lab-network-windows .lab-window {
    pointer-events: auto;
    min-width: 0;
  }

  .lab-network-windows [data-window-mode='floating'] {
    top: 28px;
    right: 0;
    width: min(520px, 100%);
  }

  @media (max-width: 900px) {
    .lab-net-topo {
      min-height: 0;
      padding: 20px 16px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .lab-tbox,
    .lab-node-rail,
    .lab-network-windows {
      position: static;
      width: 100%;
      max-width: 100%;
      display: grid;
      grid-template-columns: 1fr;
    }

    .lab-tbox-tunnel {
      border-style: dashed;
    }

    .lab-vline,
    .lab-hline {
      display: none;
    }

    .lab-node-rail {
      gap: 12px;
    }

    .lab-node::before {
      display: none;
    }
  }
</style>
