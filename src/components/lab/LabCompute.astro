---
import { NODE_DATA, COMPUTE_IDS, SNAPSHOT_LABEL } from '../../data/labSnapshot';
---

<section class="lab-scene lab-compute" data-scene="2" role="tabpanel" aria-label="Compute nodes">
  <div class="lab-compute-launchers" aria-label="Compute node launchers">
    <span class="lab-launcher-label">NODES</span>
    <button type="button" class="lab-node-launcher lab-node-selected" data-open-node="ser5-proxmox" aria-pressed="true">ser5-proxmox</button>
    <button type="button" class="lab-node-launcher" data-open-node="pve-ser-24gb" aria-pressed="false">pve-ser-24gb</button>
    <button type="button" class="lab-node-launcher" data-open-node="security-pve" aria-pressed="false">security-pve</button>
    <button type="button" class="lab-node-launcher" data-open-node="s13-proxmox" aria-pressed="false">s13-proxmox</button>
  </div>

  <p class="lab-snapshot-label">{SNAPSHOT_LABEL}<br />4 HOSTS · 24 CORES / 40 THREADS · 77.4 GiB RAM · 12 CONTAINERS + 2 VMs RUNNING</p>
  <div class="lab-tiles lab-window-layer" data-window-layer>
    {COMPUTE_IDS.map((id, i) => {
      const node = NODE_DATA[id];
      return (
        <div class:list={['lab-window', 'lab-tile', { 'lab-window-focused': i === 0 }]} data-managed-window data-window-mode="tiled" data-window-id={`compute-${id}`} data-node={id}>
          <div class="lab-titlebar"><span class="lab-tb-title">{id}</span><button type="button" class="lab-tb-x" data-window-close aria-label={`Close ${id}`}>✕</button></div>
          <div class="lab-win-body">
            <div class="lab-kv"><span class="lab-k">HW</span><span class="lab-v">{node.hw}</span></div>
            {(['cpu', 'ram'] as const).map((metric) => (
              <div class="lab-gauge-row"><span class="lab-k">{metric.toUpperCase()}</span><div class="lab-gauge"><div class="lab-gfill" data-gauge-fill={metric} style={`width:${node[metric]}%`}></div></div><span class="lab-gval" data-gauge-value={metric}>{node[metric]}%</span></div>
            ))}
            <div class="lab-svc-head">SERVICES IN SNAPSHOT</div>
            {node.svcs.map(([name, note]) => <div class="lab-svc"><span class="lab-dot"></span> {name} <span class="lab-svc-note">{note}</span></div>)}
            <div class="lab-win-foot">{node.foot}</div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="lab-hintbar">CLICK TO FOCUS&nbsp;&nbsp;&middot;&nbsp;&nbsp;DRAG TO FLOAT&nbsp;&nbsp;&middot;&nbsp;&nbsp;SUPER+Q CLOSES FOCUSED</div>
</section>

<style>
  .lab-compute-launchers {
    min-height: 44px;
    padding: 10px 28px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .lab-launcher-label {
    color: var(--lab-muted);
    font-size: 9px;
    letter-spacing: 0.22em;
    margin-right: 4px;
  }

  .lab-node-launcher {
    border: 1px solid var(--lab-border);
    background: var(--lab-surface);
    color: var(--lab-muted);
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 6px 9px;
    cursor: pointer;
  }

  .lab-node-launcher:hover,
  .lab-node-launcher.lab-node-selected {
    border-color: var(--lab-sage);
    color: var(--lab-bright);
  }

  .lab-tiles {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    padding: 16px 28px 56px;
    min-height: calc(100% - 84px);
  }

  .lab-tile {
    display: flex;
    flex-direction: column;
    border-color: var(--lab-border);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lab-tile {
      transition: border-color 0.12s ease;
    }
  }

  .lab-tile:hover {
    border-color: var(--lab-border-bright);
  }

  .lab-tile .lab-win-body {
    padding: 16px 20px;
    gap: 9px;
    flex: 1;
  }

  .lab-tile .lab-k {
    width: 42px;
  }

  .lab-tile .lab-svc-head {
    margin-top: 4px;
  }

  .lab-idle-msg {
    font-size: 12px;
    color: var(--lab-muted);
    letter-spacing: 0.12em;
    line-height: 1.9;
  }

  @media (max-width: 900px) {
    .lab-tiles {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      padding: 16px 16px 24px;
    }

    .lab-compute-launchers {
      padding: 10px 16px 0;
      flex-wrap: wrap;
    }
  }
</style>
