---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts that aren't drafts
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort posts by date (newest first)
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const count = String(posts.length).padStart(3, '0');
---

<Layout title="Posts | Pachev Joseph" description="Posts by Pachev Joseph on software engineering, technology, and more.">
  <div class="index-header">
    <div class="index-heading">
      <div class="eyebrow">
        <span class="rule"></span>
        <span>INDEX // POSTS</span>
      </div>
      <h1 class="index-title">Posts</h1>
    </div>
    <div class="index-chips">
      <a href="/posts" class="chip chip-active">POSTS</a>
      <a href="/tils" class="chip">TILS</a>
    </div>
  </div>

  <div class="index-rows">
    {posts.map(post => (
      <a href={`/posts/${post.slug}`} class="idx-row">
        <span class="idx-date">{formatDate(post.data.date)}</span>
        <span class="idx-title">{post.data.title}</span>
        <span class="idx-chip idx-chip-post">POST</span>
        <span class="idx-arrow">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </span>
      </a>
    ))}
  </div>

  <div class="index-footer">
    <span>SHOWING {count} OF {count}</span>
  </div>
</Layout>

<style>
  .index-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 48px 0 36px;
    border-bottom: 2px solid var(--color-text);
  }

  .index-heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--color-sage);
  }

  .eyebrow .rule {
    width: 28px;
    height: 1px;
    background: var(--color-sage);
    display: inline-block;
  }

  .index-title {
    font-size: 72px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0;
  }

  .index-chips {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .chip {
    border: 1px solid #b9b6a6;
    color: #5b5b51;
    padding: 9px 18px;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .chip-active {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .chip-active:hover {
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .index-rows {
    display: flex;
    flex-direction: column;
  }

  .idx-row {
    display: flex;
    align-items: baseline;
    gap: 32px;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    transition: background 0.15s ease;
  }

  .idx-row:hover {
    background: var(--color-card);
  }

  .idx-row:hover .idx-title {
    color: var(--color-accent);
  }

  .idx-row:hover .idx-arrow {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip {
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .idx-row {
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .chip:active,
    .idx-row:active {
      transform: translateY(1px);
    }
  }

  .idx-date {
    width: 110px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  .idx-title {
    flex-grow: 1;
    font-size: 24px;
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .idx-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    padding: 3px 10px;
    flex-shrink: 0;
  }

  .idx-chip-post {
    color: var(--color-accent);
    border: 1px solid var(--color-chip-border);
  }

  .idx-chip-til {
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  .idx-arrow {
    opacity: 0;
    color: var(--color-accent);
    transition: opacity 0.15s ease;
    flex-shrink: 0;
  }

  .index-footer {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
    border-top: 2px solid var(--color-text);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .index-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .index-title {
      font-size: 44px;
    }

    .idx-row {
      flex-wrap: wrap;
      gap: 8px 16px;
    }

    .idx-date {
      width: auto;
    }

    .idx-title {
      flex-basis: 100%;
      order: 3;
    }
  }
</style>
