---
import Layout from '../../layouts/Layout.astro';
import PostVariants from '../../components/PostVariants.astro';
import { formatDistance } from 'date-fns';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Variant files live next to posts as _slug.notes.md / _slug.ai.md. The
// leading underscore keeps them out of the blog collection, but they still
// import as markdown modules here.
const noteFiles = import.meta.glob<{ Content: any }>('../../content/blog/_*.notes.md');
const aiFiles = import.meta.glob<{ Content: any }>('../../content/blog/_*.ai.md');

const notesLoader = noteFiles[`../../content/blog/_${post.slug}.notes.md`];
const aiLoader = aiFiles[`../../content/blog/_${post.slug}.ai.md`];

const NotesContent = notesLoader ? (await notesLoader()).Content : null;
const AiContent = aiLoader ? (await aiLoader()).Content : null;

const assistLabels: Record<string, string> = {
  edited: 'AI-assisted, edited by me',
  heavy: 'Mostly AI-written',
};
const assistLabel = assistLabels[post.data.assist];

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.date);

const timeAgo = formatDistance(post.data.date, new Date(), { addSuffix: true });
---

<Layout title={`${post.data.title} | Pachev Joseph's Blog`} description={post.data.description}>
  <article class="blog-post">
    <div class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span class="time-ago">({timeAgo})</span>
      </div>

      {assistLabel && (
        <div class="assist-badge">
          <a href="/how-i-write">{assistLabel}</a>
        </div>
      )}


      {post.data.tags && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>

    <div class="variant-switcher">
      <PostVariants
        hasNotes={!!NotesContent}
        hasAi={!!AiContent}
        promptVersion={post.data.promptVersion}
      >
        <div class="post-content" slot="final">
          <Content />
        </div>
        {NotesContent && (
          <div class="post-content" slot="notes">
            <NotesContent />
          </div>
        )}
        {AiContent && (
          <div class="post-content" slot="ai">
            <AiContent />
          </div>
        )}
      </PostVariants>
    </div>

    <div class="post-footer">
      <div class="post-nav">
        <a href="/posts" class="btn">← Back to Posts</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: var(--space-lg);
    text-align: center;
  }

  .post-header h1 {
    font-size: 2.8rem;
    margin-bottom: var(--space-xs);
  }

  .post-meta {
    color: var(--color-muted);
    font-size: 1rem;
    margin-bottom: var(--space-sm);
  }

  .time-ago {
    font-style: italic;
  }

  .assist-badge {
    margin-bottom: var(--space-sm);
  }

  .assist-badge a {
    font-size: 0.8rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.6rem;
    border-radius: 1rem;
    text-decoration: none;
  }

  .assist-badge a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .variant-switcher {
    text-align: center;
  }

  .variant-switcher .post-content {
    text-align: left;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .tag {
    font-size: 0.8rem;
    background-color: var(--color-accent);
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    display: inline-block;
  }

  .post-content {
    line-height: 1.7;
    font-size: 1.1rem;
  }
  
  .post-content :global(pre) {
    padding: 1rem 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background-color: transparent;
    padding: 0;
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .post-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace;
    background-color: rgba(0, 0, 0, 0.07);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .post-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 2rem;
    }
    
    .post-content {
      font-size: 1rem;
    }
  }
</style>