---
// Standalone page: /lab is the one route that becomes a full-viewport dark
// desktop, so it does NOT use the site Layout (no header/footer).
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import '../../styles/lab.css';
import LabWaybar from '../../components/lab/LabWaybar.astro';
import LabBoot from '../../components/lab/LabBoot.astro';
import LabNetwork from '../../components/lab/LabNetwork.astro';
import LabCompute from '../../components/lab/LabCompute.astro';
import LabStorage from '../../components/lab/LabStorage.astro';
import LabLog from '../../components/lab/LabLog.astro';

const allPosts = await getCollection('lab', ({ data }) => !data.draft);
const noscriptPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Home Lab Journal and fake desktop environment by Pachev Joseph." />
    <title>Lab | Pachev Joseph</title>
    <noscript>
      <style>
        .lab-desktop {
          display: none;
        }

        .lab-noscript {
          display: block;
          background: #f2f0e9;
          color: #191b18;
          min-height: 100vh;
          font-family: var(--font-primary);
          padding: var(--space-xl) var(--space-md);
        }

        .lab-noscript-inner {
          max-width: 720px;
          margin: 0 auto;
        }

        .lab-noscript h1 {
          margin-bottom: var(--space-sm);
        }

        .lab-noscript ul {
          list-style: none;
          padding-left: 0;
          margin-bottom: var(--space-lg);
        }

        .lab-noscript li {
          padding: var(--space-sm) 0;
          border-bottom: 1px solid #dcd9cc;
        }

        .lab-noscript a {
          color: #55654f;
          font-weight: 600;
        }
      </style>
    </noscript>
  </head>
  <body>
    <noscript>
      <div class="lab-noscript">
        <div class="lab-noscript-inner">
          <h1>Home Lab Journal</h1>
          {noscriptPosts.length > 0 ? (
            <ul>
              {noscriptPosts.map((post) => (
                <li><a href={`/lab/${post.slug}`}>{post.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p>No entries yet.</p>
          )}
          <p><a href="/">&larr; Back home</a></p>
        </div>
      </div>
    </noscript>

    <div class="lab-desktop" id="lab-desktop">
      <LabBoot />
      <LabWaybar />
      <div class="lab-scenes">
        <LabNetwork />
        <LabCompute />
        <LabStorage />
        <LabLog />
      </div>
    </div>

    <script>
      const bootEl = document.getElementById('lab-boot') as HTMLElement | null;
      const bootBarFill = document.getElementById('lab-boot-bar-fill') as HTMLElement | null;
      const bootPct = document.getElementById('lab-boot-pct') as HTMLElement | null;
      const bootEnter = document.getElementById('lab-boot-enter') as HTMLButtonElement | null;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function hideBoot(instant: boolean) {
        if (!bootEl) return;

        if (instant || prefersReducedMotion) {
          bootEl.hidden = true;
          return;
        }

        bootEl.classList.add('lab-boot-fade');
        window.setTimeout(() => {
          bootEl.hidden = true;
        }, 200);
      }

      function showBoot() {
        if (!bootEl || !bootBarFill || !bootPct || !bootEnter) return;
        bootEl.hidden = false;

        if (prefersReducedMotion) {
          bootBarFill.classList.add('lab-boot-full');
          bootPct.textContent = '100%';
          bootEnter.hidden = false;
          return;
        }

        // Animate the fill via CSS transition, then reveal ENTER SYSTEM.
        requestAnimationFrame(() => {
          bootBarFill.classList.add('lab-boot-full');
        });

        const duration = 1400;
        const start = performance.now();
        function tick(now: number) {
          const elapsed = now - start;
          const pct = Math.min(100, Math.round((elapsed / duration) * 100));
          if (bootPct) bootPct.textContent = `${pct}%`;
          if (elapsed < duration) {
            requestAnimationFrame(tick);
          } else {
            if (bootPct) bootPct.textContent = '100%';
            if (bootEnter) bootEnter.hidden = false;
          }
        }
        requestAnimationFrame(tick);
      }

      // The boot sequence plays on every entry; ESC or ENTER SYSTEM dismisses it.
      showBoot();

      bootEnter?.addEventListener('click', () => hideBoot(false));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bootEl && !bootEl.hidden) {
          hideBoot(false);
        }
      });

      // ---------- Workspace switching ----------

      const scenes = Array.from(document.querySelectorAll<HTMLElement>('.lab-scene'));
      const wsButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lab-ws'));

      function activateWorkspace(id: string) {
        scenes.forEach((scene) => {
          scene.classList.toggle('active', scene.dataset.scene === id);
        });
        wsButtons.forEach((btn) => {
          const isActive = btn.dataset.workspace === id;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      wsButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.workspace;
          if (id) activateWorkspace(id);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement | null;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return;

        if (['1', '2', '3', '4'].includes(e.key)) {
          activateWorkspace(e.key);
        }
      });

      // ---------- Network: node click drives the inspector ----------

      type NodeInfo = {
        hw: string;
        platform: string;
        cpu: number;
        ram: number;
        svcs: [string, string][];
        foot: string;
      };

      const NODE_DATA: Record<string, NodeInfo> = {
        'security-pve': {
          hw: 'INTEL N150 · 4C · 15G · CORAL TPU (USB)',
          platform: 'PROXMOX VE 8.4 · KERNEL 6.14',
          cpu: 34,
          ram: 31,
          svcs: [['frigate', 'nixos ct 205 · 6 cameras'], ['coral-tpu', 'inference 8.1ms']],
          foot: '$ uptime → 13 days. do not jinx it.',
        },
        'ser5-proxmox': {
          hw: 'RYZEN 7 5850U · 16C · 27G',
          platform: 'PROXMOX VE 8.4 · KERNEL 6.11',
          cpu: 4,
          ram: 70,
          svcs: [['coolify', 'ships this very site'], ['home-assistant', 'vm 108'], ['adguard', 'dns for everything'], ['excalidraw', 'team whiteboard'], ['forgejo', 'ct 211 · git at home'], ['atuin', 'ct 110 · shell history'], ['metrics', 'ct 208 · victoriametrics']],
          foot: '$ uptime → 13 days. the elder node.',
        },
        'pve-ser-24gb': {
          hw: 'RYZEN 7 6800U · 16C · 19G',
          platform: 'PROXMOX VE 8.4 · KERNEL 6.8',
          cpu: 5,
          ram: 27,
          svcs: [['katzenbase', 'the second brain'], ['immich', 'nixos ct 206'], ['mast', 'lxc 200'], ['hermes-agent', 'lxc 109'], ['github-runner', 'ci, nixos ct 207']],
          foot: '$ uptime → 6 days. once took five power cycles. haunted.',
        },
        's13-proxmox': {
          hw: 'INTEL N150 · 4C · 15G',
          platform: 'PROXMOX VE 8.4 · KERNEL 6.14',
          cpu: 2,
          ram: 13,
          svcs: [],
          foot: '$ uptime → 9 days. doing nothing, flawlessly.',
        },
        'joseph-nas': {
          hw: 'RYZEN 5 · NODE 304 · 16G · ZFS 4×HDD',
          platform: 'UBUNTU SERVER · NFS + ZFS',
          cpu: 2,
          ram: 67,
          svcs: [['nfs', '4 exports'], ['telegraf', 'vitals to victoriametrics'], ['zpool scrub', '0 errors']],
          foot: '$ uptime → 15.9 weeks. the adult in the room.',
        },
      };

      const inspTitle = document.getElementById('lab-insp-title');
      const inspHw = document.getElementById('lab-insp-hw');
      const inspPlatform = document.getElementById('lab-insp-platform');
      const inspCpuFill = document.getElementById('lab-insp-cpu-fill');
      const inspCpuVal = document.getElementById('lab-insp-cpu-val');
      const inspRamFill = document.getElementById('lab-insp-ram-fill');
      const inspRamVal = document.getElementById('lab-insp-ram-val');
      const inspSvcs = document.getElementById('lab-insp-svcs');
      const inspFoot = document.getElementById('lab-insp-foot');
      const nodeCards = Array.from(document.querySelectorAll<HTMLElement>('.lab-node[data-node]'));

      function inspectNode(id: string) {
        const info = NODE_DATA[id];
        if (!info || !inspSvcs) return;

        if (inspTitle) inspTitle.textContent = `${id} — node inspector`;
        if (inspHw) inspHw.textContent = info.hw;
        if (inspPlatform) inspPlatform.textContent = info.platform;
        if (inspCpuFill) inspCpuFill.style.width = `${info.cpu}%`;
        if (inspCpuVal) inspCpuVal.textContent = `${info.cpu}%`;
        if (inspRamFill) inspRamFill.style.width = `${info.ram}%`;
        if (inspRamVal) inspRamVal.textContent = `${info.ram}%`;

        inspSvcs.textContent = '';
        if (info.svcs.length === 0) {
          const idle = document.createElement('div');
          idle.className = 'lab-idle-msg';
          idle.textContent = 'NONE. IDLE // AWAITING PURPOSE';
          inspSvcs.appendChild(idle);
        } else {
          for (const [name, note] of info.svcs) {
            const row = document.createElement('div');
            row.className = 'lab-svc';
            const dot = document.createElement('span');
            dot.className = 'lab-dot';
            const noteEl = document.createElement('span');
            noteEl.className = 'lab-svc-note';
            noteEl.textContent = note;
            row.appendChild(dot);
            row.appendChild(document.createTextNode(` ${name} `));
            row.appendChild(noteEl);
            inspSvcs.appendChild(row);
          }
        }

        if (inspFoot) {
          inspFoot.textContent = info.foot;
          const caret = document.createElement('span');
          caret.className = 'lab-caret';
          caret.textContent = '▮';
          inspFoot.appendChild(caret);
        }

        nodeCards.forEach((card) => {
          card.classList.toggle('lab-node-selected', card.dataset.node === id);
        });
      }

      nodeCards.forEach((card) => {
        card.addEventListener('click', () => {
          const id = card.dataset.node;
          if (id) inspectNode(id);
        });
      });

      // ---------- Compute: click a tile to focus it ----------

      const tiles = Array.from(document.querySelectorAll<HTMLElement>('.lab-tile'));
      tiles.forEach((tile) => {
        tile.addEventListener('click', () => {
          tiles.forEach((t) => t.classList.toggle('lab-tile-focused', t === tile));
        });
      });

      // ---------- Live clock ----------

      const clockEl = document.getElementById('lab-clock');
      function updateClock() {
        if (!clockEl) return;
        const now = new Date();
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        clockEl.textContent = `${hh}:${mm}`;
      }
      updateClock();
      setInterval(updateClock, 60000);
    </script>
  </body>
</html>
