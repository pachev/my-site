---
// Standalone page: /lab is the one route that becomes a full-viewport dark
// desktop, so it does NOT use the site Layout (no header/footer).
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import '../../styles/lab.css';
import LabWaybar from '../../components/lab/LabWaybar.astro';
import LabBoot from '../../components/lab/LabBoot.astro';
import LabNetwork from '../../components/lab/LabNetwork.astro';
import LabCompute from '../../components/lab/LabCompute.astro';
import LabStorage from '../../components/lab/LabStorage.astro';
import LabLog from '../../components/lab/LabLog.astro';

const allPosts = await getCollection('lab', ({ data }) => !data.draft);
const noscriptPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Home Lab Journal and fake desktop environment by Pachev Joseph." />
    <title>Lab | Pachev Joseph</title>
    <noscript>
      <style>
        .lab-desktop {
          display: none;
        }

        .lab-noscript {
          display: block;
          background: #f2f0e9;
          color: #191b18;
          min-height: 100vh;
          font-family: var(--font-primary);
          padding: var(--space-xl) var(--space-md);
        }

        .lab-noscript-inner {
          max-width: 720px;
          margin: 0 auto;
        }

        .lab-noscript h1 {
          margin-bottom: var(--space-sm);
        }

        .lab-noscript ul {
          list-style: none;
          padding-left: 0;
          margin-bottom: var(--space-lg);
        }

        .lab-noscript li {
          padding: var(--space-sm) 0;
          border-bottom: 1px solid #dcd9cc;
        }

        .lab-noscript a {
          color: #55654f;
          font-weight: 600;
        }
      </style>
    </noscript>
  </head>
  <body>
    <noscript>
      <div class="lab-noscript">
        <div class="lab-noscript-inner">
          <h1>Home Lab Journal</h1>
          {noscriptPosts.length > 0 ? (
            <ul>
              {noscriptPosts.map((post) => (
                <li><a href={`/lab/${post.slug}`}>{post.data.title}</a></li>
              ))}
            </ul>
          ) : (
            <p>No entries yet.</p>
          )}
          <p><a href="/">&larr; Back home</a></p>
        </div>
      </div>
    </noscript>

    <div class="lab-desktop" id="lab-desktop">
      <LabBoot />
      <LabWaybar />
      <div class="lab-scenes">
        <LabNetwork />
        <LabCompute />
        <LabStorage />
        <LabLog />
      </div>
    </div>

    <script>
      const bootEl = document.getElementById('lab-boot') as HTMLElement | null;
      const bootBarFill = document.getElementById('lab-boot-bar-fill') as HTMLElement | null;
      const bootPct = document.getElementById('lab-boot-pct') as HTMLElement | null;
      const bootEnter = document.getElementById('lab-boot-enter') as HTMLButtonElement | null;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alreadyBooted = sessionStorage.getItem('lab-booted') === '1';

      function hideBoot(instant: boolean) {
        if (!bootEl) return;
        sessionStorage.setItem('lab-booted', '1');

        if (instant || prefersReducedMotion) {
          bootEl.hidden = true;
          return;
        }

        bootEl.classList.add('lab-boot-fade');
        window.setTimeout(() => {
          bootEl.hidden = true;
        }, 200);
      }

      function showBoot() {
        if (!bootEl || !bootBarFill || !bootPct || !bootEnter) return;
        bootEl.hidden = false;

        if (prefersReducedMotion) {
          bootBarFill.classList.add('lab-boot-full');
          bootPct.textContent = '100%';
          bootEnter.hidden = false;
          return;
        }

        // Animate the fill via CSS transition, then reveal ENTER SYSTEM.
        requestAnimationFrame(() => {
          bootBarFill.classList.add('lab-boot-full');
        });

        const duration = 1400;
        const start = performance.now();
        function tick(now: number) {
          const elapsed = now - start;
          const pct = Math.min(100, Math.round((elapsed / duration) * 100));
          if (bootPct) bootPct.textContent = `${pct}%`;
          if (elapsed < duration) {
            requestAnimationFrame(tick);
          } else {
            if (bootPct) bootPct.textContent = '100%';
            if (bootEnter) bootEnter.hidden = false;
          }
        }
        requestAnimationFrame(tick);
      }

      if (!alreadyBooted) {
        showBoot();
      }
      // If alreadyBooted, overlay stays hidden (default markup state).

      bootEnter?.addEventListener('click', () => hideBoot(false));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bootEl && !bootEl.hidden) {
          hideBoot(false);
        }
      });

      // ---------- Workspace switching ----------

      const scenes = Array.from(document.querySelectorAll<HTMLElement>('.lab-scene'));
      const wsButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lab-ws'));

      function activateWorkspace(id: string) {
        scenes.forEach((scene) => {
          scene.classList.toggle('active', scene.dataset.scene === id);
        });
        wsButtons.forEach((btn) => {
          const isActive = btn.dataset.workspace === id;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      wsButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.workspace;
          if (id) activateWorkspace(id);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement | null;
        if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)) return;

        if (['1', '2', '3', '4'].includes(e.key)) {
          activateWorkspace(e.key);
        }
      });

      // ---------- Live clock ----------

      const clockEl = document.getElementById('lab-clock');
      function updateClock() {
        if (!clockEl) return;
        const now = new Date();
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        clockEl.textContent = `${hh}:${mm}`;
      }
      updateClock();
      setInterval(updateClock, 60000);
    </script>
  </body>
</html>
